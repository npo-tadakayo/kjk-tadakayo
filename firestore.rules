rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    function emailIsTadakayo() {
      return isAuthenticated() && request.auth.token.email.matches('.*@tadakayo[.]jp$');
    }
    // users/{email} に登録があり active==true の @tadakayo.jp ユーザー（練習生を除く）
    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.token.email)).data;
    }
    // 2026-10-20 テストモード: ロール「練習生（trainee）」は本番DBを読み書きとも不可にする。
    // 練習生は練習DB（practice・firestore.practice.rules）だけを使う。画面側で練習モードに
    // 固定するが、画面の漏れがあっても本番の案件・事業所を見られないよう、サーバー側で止める。
    // isEditor / isAdmin はこの関数から派生するので、練習生はそれらでも自動で拒否される。
    // 例外として、練習生も自分の users/{email} だけは読める（ログイン時のロール確認に必要。
    // 下の users のルールの「本人なら読める」は isRegistered() を経由しないので、そのまま通る）。
    // role が未設定の登録者は、これまでどおり登録済み（読める）として扱う。
    // そのため .role ではなく .get('role', '') で読む（無いフィールドを .role で読むと評価エラー＝拒否になり、
    // role 未設定の人の閲覧まで止めてしまう。2026-10-20 ルールテストで確認）。
    function isRegistered() {
      return emailIsTadakayo()
        && exists(/databases/$(database)/documents/users/$(request.auth.token.email))
        && userData().active == true
        && userData().get('role', '') != 'trainee';
    }
    function isAdmin() {
      return isRegistered() && userData().role == 'admin';
    }
    // 書き込める人＝登録済みで、ロールが「閲覧のみ（viewer）」でない人。
    // 2026-08-31 追加。それまでルールは isRegistered() だけを見ており、
    // 「閲覧のみ」で登録された人も案件・出荷・設定を書き換えられた
    // （画面では統合ボタンを隠していただけで、実際には保存が通った）。
    // 表示と実態が食い違ったままだったので、サーバー側で止める。
    function isEditor() {
      return isRegistered() && userData().role != 'viewer';
    }
    // 認定事業所パートナー
    function isPartner() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/partners/$(request.auth.token.email))
        && get(/databases/$(database)/documents/partners/$(request.auth.token.email)).data.active == true;
    }

    // ユーザー（ロール）管理: 本人は自分の登録を読める／管理は管理者のみ
    // 例外: 本人は自分の onboardingDismissedAt だけ書ける（ホームの「はじめての方へ」カードを
    // 閉じた記録・2026-09-14追加）。role/active等それ以外のフィールドは引き続き管理者のみ。
    match /users/{email} {
      allow read: if isAuthenticated() && (request.auth.token.email == email || isAdmin());
      allow write: if isAdmin()
        || (
          emailIsTadakayo() && request.auth.token.email == email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["onboardingDismissedAt"])
          && request.resource.data.onboardingDismissedAt == request.time
        );
    }

    // 商品マスタ: 認証済みは閲覧可（パートナーのカタログ参照）／編集は登録スタッフ
    match /products/{sku} {
      allow read: if isAuthenticated();
      allow write: if isEditor();
    }

    // 認定事業所名簿: 本人は自分の登録を読める／管理は登録スタッフ
    match /partners/{email} {
      allow read: if isRegistered() || (isAuthenticated() && request.auth.token.email == email);
      allow write: if isEditor();
    }

    // 認定事業所からの発注（受注）
    match /partnerOrders/{id} {
      allow create: if isPartner() && request.resource.data.partnerEmail == request.auth.token.email;
      allow read: if isRegistered()
        || (isPartner() && resource.data.partnerEmail == request.auth.token.email);
      allow update, delete: if isEditor();
    }

    // 伴走支援承諾書の署名依頼。
    // ドキュメントIDが推測不能なトークン（128bit乱数）＝URLを知っていることが鍵。
    //   ・get のみ公開（list は不可＝列挙できない）
    //   ・未署名（pending）のときに限り、未認証でも status と signed の2フィールドだけ
    //     "signed" への一方向更新ができる。署名済みの書き換え・取り消しは職員でも editor のみ
    //   ・signedAt はサーバ時刻を強制（端末の時計を信用しない）
    match /consentRequests/{token} {
      allow get: if true;
      allow list: if isRegistered();
      allow create, delete: if isEditor();
      allow update: if isEditor()
        || (
          resource.data.status == "pending"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "signed"])
          && request.resource.data.status == "signed"
          && request.resource.data.signed is map
          && request.resource.data.signed.keys().hasOnly(["name", "signedAt", "method", "userAgent"])
          && request.resource.data.signed.name is string
          && request.resource.data.signed.name.size() > 0
          && request.resource.data.signed.name.size() <= 100
          && request.resource.data.signed.signedAt == request.time
          && request.resource.data.signed.method == "web"
          && (!("userAgent" in request.resource.data.signed)
              || (request.resource.data.signed.userAgent is string
                  && request.resource.data.signed.userAgent.size() <= 300))
        );
    }

    // 問い合わせ→見積もり→申し込みを同じ事業所として繋ぐ継続トークン（2026-09-06）。
    // ドキュメントIDが128bit乱数。URLを知っている本人だけが get できる。書き込みは Functions（Admin SDK）のみ。
    match /leadTokens/{token} {
      allow get: if true;
      allow list: if isRegistered();
      allow write: if false;
    }

    // 見積もり（版を重ねる記録）。閲覧は登録スタッフ、作成・改版は Functions が行う。
    // スタッフが直接直すのは status などの軽微な項目に限る想定（editor）。
    match /quotes/{quoteId} {
      allow read: if isRegistered();
      allow write: if isEditor();
    }

    // 伴走支援者バッジの付与履歴・トレーニング評価（2026-10-18）。
    // 履歴なので、登録スタッフは追加（create）だけ。訂正・削除は管理者のみ。
    // 「付与はトレーナーのみ」は画面側の制限（名簿は users の氏名照合のためルールでは見ない）。
    match /supportBadges/{id} {
      allow read: if isRegistered();
      allow create: if isEditor();
      allow update, delete: if isAdmin();
    }
    // 評価は同じ案件・日付・受講者のIDで上書き保存するため、create/update は登録スタッフ、削除は管理者のみ
    match /supportEvaluations/{id} {
      allow read: if isRegistered();
      allow create, update: if isEditor();
      allow delete: if isAdmin();
    }

    // それ以外（案件・事業所・在庫・発注・出荷・設定・カウンタ等）は登録スタッフのみ
    //
    // ⚠ 2026-10-20 修正: Firestore のルールは「どれか1つの match が許せば通る」。この「その他すべて」は
    //    上の個別の match のパスにも当たるため、個別に書いた制限（users は管理者だけ等）を素通りさせていた。
    //    実際に、登録スタッフなら誰でも users を書き換えられた（自分を admin にできた）。
    //    個別の match で書き込みを「狭く」決めているコレクションは、ここでの書き込みの対象から外す:
    //      users（管理者と本人の onboarding だけ）／leadTokens（Functions だけ）／
    //      supportBadges（訂正・削除は管理者だけ）／supportEvaluations（削除は管理者だけ）
    //    読み取りは従来どおり（担当営業の候補などで職員が users を読んでいるため、ここでは変えない）。
    //    partnerOrders は職員の発注ファイル取り込み（supply.js）がここの書き込みに頼っているので対象外にしない。
    match /{coll}/{document=**} {
      allow read: if isRegistered();
      allow write: if isEditor()
        && !(coll in ["users", "leadTokens", "supportBadges", "supportEvaluations"]);
    }
  }
}
