rules_version = '2';
// 練習DB（Firestore データベース `practice`）のルール。2026-10-20 テストモードで新設。
// 本番DB（(default)）のルールは firestore.rules。firebase.json の firestore 配列でDBごとに割り当てる。
//
// ・中身は架空データだけ（事業所・案件・見積・出荷などの練習用。初期化は Functions が practice DB にだけ書く）。
// ・ルールから別DB（本番）の users を見に行けないため、ロール（閲覧のみ・練習生など）の区別は
//   練習DBではしない。@tadakayo.jp でメール確認済みのログインなら、誰でも読み書きできる。
// ・ロール確認は画面が常に本番DBの users/自分 を読んで行う。練習DBには users を置かない
//   （置いても使われず、ロールを偽装した書き込みの誤解を招くので、読み書きとも閉じる）。
// ・2026-10-24 倉庫（role "warehouse"）: このルールでは区別できない（上のとおり本番の users を見に行けない）ため、変えない。
//   練習DBの中身は架空データだけなので、倉庫の人が練習DBを読めても個人情報・本番の金額は漏れない。
//   倉庫の人は練習モードを使わない（画面は練習モードの切り替えを出さず /warehouse だけに固定・本番の操作は warehouse* の Callable だけ）。
//   本番DB（firestore.rules）では isRegistered() から倉庫の人を外している。
service cloud.firestore {
  match /databases/{database}/documents {
    function isTadakayoStaff() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@tadakayo[.]jp$');
    }

    // ユーザー（ロール）は練習DBに置かない。誰も読み書きできない。
    match /users/{email} {
      allow read, write: if false;
    }

    // 通知の送信記録（_notifyLog）は練習DBでは使わない（通知のトリガーは本番DBだけに反応する・2026-10-21）。
    // 練習中の画面も読まないので、読み書きとも閉じる。
    match /_notifyLog/{id} {
      allow read, write: if false;
    }

    // それ以外（練習用の案件・事業所・見積・出荷・設定・入金明細の取り込み記録 bankTxns・
    // 列割り当て／名義の学習 bankConfig など）は @tadakayo.jp の職員なら読み書き可。
    // 注: Firestore のルールは「どれか1つの match が許可すれば通る」ので、ここで users・_notifyLog を
    //     除外しておかないと上の false が効かない。そのためコレクション名で除く。
    match /{collection}/{docId=**} {
      allow read, write: if !(collection in ['users', '_notifyLog']) && isTadakayoStaff();
    }
  }
}
